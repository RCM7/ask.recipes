        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Search recipes",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "share_recipe",
      "title": "Create a share link",
      "description": "Create a share link for one of the user's uploaded recipes, for \"send this to my wife\", \"share it with Tom\", \"give me a link\". Returns a share.ask.recipes URL that opens without an account and is not listed or indexed; the page credits the recipe's original source. Only recipes the user uploaded can be shared; for other recipes the source link is the thing to share.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "id of a recipe the user uploaded",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Create a share link",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "upload_recipe",
      "title": "Upload a private recipe",
      "description": "Add a recipe the user supplies themselves: pasted in, dictated, a family recipe they want kept, or a web page they point at. For a web page, pass the page's raw HTML or its JSON-LD as markup together with source_url; the server extracts the facts. Each call creates a new private recipe, visible only to this user in searches and saves.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "recipe name; may be left empty when markup carries the recipe"
          },
          "description": {
            "type": "string"
          },
          "ingredients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "one ingredient per entry, with quantities, e.g. '2 cups rolled oats'"
          },
          "instructions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "one step per entry"
          },
          "yield": {
            "type": "string"
          },
          "total_minutes": {
            "type": "integer"
          },
          "source_url": {
            "type": "string",
            "description": "the web page the recipe came from, if any; kept as attribution on the private copy"
          },
          "markup": {
            "type": "string",
            "description": "for a recipe from a web page: the page's raw HTML, or just its schema.org/Recipe JSON-LD block, as fetched by the agent; the server extracts name, ingredients, steps, times, nutrition and rating from it, so the other fields can stay empty"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Upload a private recipe",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ],
  "version": "1.1.0",
  "icon": "https://ask.recipes/icon-512.png",
  "tags": [
    "recipes",
