{
  "author": "Ricardo Marques",
  "authorUrl": "https://github.com/RCM7",
  "cloudEndpoint": "https://mcp.ask.recipes/mcp",
  "description": "Recipe search, ingredient matching, nutrition filters and a private cookbook for any AI agent.",
  "homepage": "https://ask.recipes",
  "identifier": "ask-recipes",
  "name": "ask.recipes",
  "prompts": [
    {
      "name": "cook_what_i_have",
      "title": "Cook with what I have",
      "description": "Turn the ingredients on hand into a ranked list of recipes, with what each one is missing.",
      "arguments": [
        {
          "name": "ingredients",
          "description": "What is in the fridge or pantry, comma separated.",
          "required": true
        },
        {
          "name": "minutes",
          "description": "Most time you want to spend, total."
        }
      ]
    },
    {
      "name": "dinner_tonight",
      "title": "Dinner tonight",
      "description": "Pick a well-rated dinner for tonight within a time, serving and diet constraint.",
      "arguments": [
        {
          "name": "minutes",
          "description": "Most time you want to spend, total."
        },
        {
          "name": "servings",
          "description": "How many people are eating."
        },
        {
          "name": "diet",
          "description": "Any constraint: vegetarian, vegan, gluten-free, dairy-free, nut-free."
        }
      ]
    }
  ],
  "resources": [
    {
      "name": "docs",
      "title": "ask.recipes docs",
      "uri": "ask-recipes://docs",
      "description": "How to connect, what to ask, what each tool does, defaults and support.",
      "mimeType": "text/markdown"
    }
  ],
  "tools": [
    {
      "name": "find_by_ingredients",
      "title": "Find recipes by ingredients on hand",
      "description": "Find recipes that use ingredients the user already has: leftovers, a full fridge, an ingredient about to turn. Ranks by how many of those ingredients a recipe uses and how few extra ones it needs. Each result links to its source.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ingredients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "ingredients on hand, e.g. ['oats','milk','eggs','skyr','berries']"
          },
          "query": {
            "type": "string",
            "description": "optional free-text to narrow results, e.g. 'breakfast pancakes'"
          },
          "max_total_minutes": {
            "type": "integer"
          },
          "min_rating": {
            "type": "number",
            "description": "minimum source star rating, default 4.2"
          },
          "min_reviews": {
            "type": "integer",
            "description": "minimum number of source ratings, default 25"
          },
          "limit": {
            "type": "integer"
          },
          "min_calories": {
            "type": "number",
            "description": "only recipes with at least this many calories per serving"
          },
          "max_calories": {
            "type": "number",
            "description": "only recipes with at most this many calories per serving, e.g. 300"
          },
          "min_protein_g": {
            "type": "number",
            "description": "minimum grams of protein per serving, e.g. 10"
          },
          "max_fat_g": {
            "type": "number",
            "description": "maximum grams of fat per serving"
          },
          "max_carbs_g": {
            "type": "number",
            "description": "maximum grams of carbohydrates per serving"
          },
          "max_sugar_g": {
            "type": "number",
            "description": "maximum grams of sugar per serving"
          },
          "min_fiber_g": {
            "type": "number",
            "description": "minimum grams of fiber per serving"
          }
        },
        "required": [
          "ingredients"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "total_minutes": {
                  "type": "integer"
                },
                "rating": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "rating_count": {
                  "type": "integer"
                },
                "calories": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "protein_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "fat_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "carbs_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "sugar_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "fiber_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "source_site": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string"
                },
                "matched_ingredients": {
                  "type": "integer"
                },
                "total_ingredients": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "rating_count",
                "source_site",
                "source_url",
                "matched_ingredients",
                "total_ingredients"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "matches"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Find recipes by ingredients on hand",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_recipe",
      "title": "Get a recipe in full",
      "description": "Get one recipe in full: ingredients, step-by-step instructions, times, yield, nutrition and its source link. For when the user picks a recipe from a search or asks how to make it.",
      "inputSchema": {
