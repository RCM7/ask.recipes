          }
        },
        "required": [
          "id",
          "name",
          "rating_count",
          "source_site",
          "source_url",
          "ingredients",
          "instructions",
          "attribution"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Get a recipe in full",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
