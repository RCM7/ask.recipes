            ]
          },
          "fiber_g": {
            "type": [
              "null",
              "number"
            ]
          },
          "source_site": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "ingredients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "yield": {
            "type": "string"
          },
          "prep_minutes": {
            "type": "integer"
          },
          "cook_minutes": {
