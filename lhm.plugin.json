    {
      "name": "save_recipe",
      "title": "Save a recipe",
      "description": "Save a recipe to the user's collection, for \"save that one\", \"keep this\", \"add it to my recipes\". Saving the same recipe twice has no further effect.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "recipe id to save",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "saved",
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Save a recipe",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_recipes",
      "title": "Search recipes",
      "description": "Search human-rated recipes for a what-to-cook or what-to-eat question: dinner tonight, cooking for guests, a quick weeknight meal, a protein or calorie target. Every result links to its source. Filters by time, rating, review count and nutrition (calories, protein, fat, carbs, sugar, fiber; per-serving values as reported by the source). Recipes without nutrition data are excluded when a nutrition filter is set. Defaults to >=4.2 stars and >=25 ratings; pass min_rating=-1 or min_reviews=-1 to disable a filter.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "the dish or main ingredients, e.g. 'overnight oats' or 'chicken curry'; express time, rating and nutrition limits with the filters rather than in words"
          },
          "max_total_minutes": {
            "type": "integer",
            "description": "only recipes taking at most this many minutes total"
          },
          "min_rating": {
            "type": "number",
            "description": "minimum source star rating, default 4.2; pass a lower value to loosen"
          },
          "min_reviews": {
            "type": "integer",
            "description": "minimum number of source ratings, default 25; pass a lower value to loosen"
          },
          "site": {
            "type": "string",
            "description": "restrict to one source site slug, e.g. budgetbytes"
          },
          "limit": {
            "type": "integer",
            "description": "max results, default 10, max 50"
          },
          "min_calories": {
            "type": "number",
            "description": "only recipes with at least this many calories per serving"
          },
          "max_calories": {
            "type": "number",
            "description": "only recipes with at most this many calories per serving, e.g. 300"
          },
          "min_protein_g": {
            "type": "number",
            "description": "minimum grams of protein per serving, e.g. 10"
          },
          "max_fat_g": {
            "type": "number",
            "description": "maximum grams of fat per serving"
          },
          "max_carbs_g": {
            "type": "number",
            "description": "maximum grams of carbohydrates per serving"
          },
          "max_sugar_g": {
            "type": "number",
            "description": "maximum grams of sugar per serving"
          },
          "min_fiber_g": {
            "type": "number",
            "description": "minimum grams of fiber per serving"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "recipes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "total_minutes": {
                  "type": "integer"
                },
                "rating": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "rating_count": {
                  "type": "integer"
                },
                "calories": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "protein_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "fat_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "carbs_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "sugar_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "fiber_g": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "source_site": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string"
                }
              },
              "required": [
